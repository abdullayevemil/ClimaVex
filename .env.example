# Copy to .env — these defaults work with the docker command in the README.
# Port 5433 avoids clashing with an existing local Postgres on 5432.
DATABASE_URL="postgresql://postgres:dev@localhost:5433/climavex?schema=public"

# Any long random string. Generate one with: openssl rand -hex 32
SESSION_SECRET="dev-only-secret-replace-me-with-openssl-rand-hex-32"

# The trained model is not connected in this phase; this is the only value accepted.
PROVIDER=deterministic

# Basemaps. Both are free and need no API key. Satellite is the default.
NEXT_PUBLIC_SATELLITE_TILE_URL="https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
NEXT_PUBLIC_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
